# Neon connection string (Dashboard → Connection details → URI)
# Use the "pooled" connection for serverless/Vercel.
# Keep as ONE line — do not put sslmode=require on a separate line.
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Local API server port (npm run dev:api)
API_PORT=3001

# Telegram username for orders (without @)
# Opens chat with prefilled order text from cart checkout
VITE_TELEGRAM_USERNAME=belkson

# Instagram username (without @) — footer / menu social link
VITE_INSTAGRAM_USERNAME=belkson

# Debug flag: show link to original Zara website on product cards
VITE_SHOW_PRODUCT=true

# Server-only Next catalogue source. Never expose these as VITE_* variables.
# The partner endpoint must return an array or { products: [] }. To enable
# automatic unpublishing, it must return { products: [], complete: true } only
# after delivering the complete region/category snapshot.
NEXT_SOURCE_URL=https://partner.example.com/catalog
NEXT_SOURCE_TOKEN=replace-with-partner-token
# Defaults to Authorization and sends "Bearer $NEXT_SOURCE_TOKEN".
NEXT_SOURCE_AUTH_HEADER=Authorization

# Protects Vercel Cron and manual server-side catalogue sync requests.
CRON_SECRET=replace-with-a-long-random-secret
